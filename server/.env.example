# ── Server (Required) ─────────────────────────────────────────────────────────

# Node environment — must be "production" on Render
NODE_ENV=production

# Port — Render sets this automatically, leave unset locally to default to 3001
# PORT=3001

# PostgreSQL — use your Neon connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis — use your Upstash connection string (rediss:// for TLS)
# For local Docker, comment this out and use REDIS_HOST + REDIS_PORT instead
REDIS_URL=rediss://user:password@hostname:port

# For local Docker Redis only (leave blank in production when REDIS_URL is set)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# JWT secrets — use long random strings (at least 64 chars)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret

# Cookie signing secret
COOKIE_SECRET=replace_with_another_long_random_secret

# CORS — comma-separated list of allowed frontend origins
# In production: set this to your Vercel deployment URL
CORS_ORIGINS=http://localhost:5173

# ── Server (Optional) ─────────────────────────────────────────────────────────

# SLA configuration (in minutes)
SLA_ESCALATION_MINUTES=10
AUTO_CLOSE_MINUTES=30
TRANSCRIPT_FLUSH_INTERVAL_MS=30000

# Email via Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=QueueDesk <onboarding@resend.dev>
# Your email address — receives SLA escalation alerts
ADMIN_EMAIL=you@gmail.com
