# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=changeme_access_secret_replace_before_deploy
JWT_REFRESH_SECRET=changeme_refresh_secret_replace_before_deploy
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/queuedesk?sslmode=require

# Redis (local Docker — docker-compose up -d)
REDIS_HOST=localhost
REDIS_PORT=6379

# SLA & job config
SLA_ESCALATION_MINUTES=10
AUTO_CLOSE_MINUTES=30
TRANSCRIPT_FLUSH_INTERVAL_MS=30000

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173

# Cookie
COOKIE_SECRET=changeme_cookie_secret_replace_before_deploy

# Email (dev: use Ethereal https://ethereal.email, prod: SendGrid)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=support@queuedesk.local
